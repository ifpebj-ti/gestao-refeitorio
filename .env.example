# Banco de Dados
DB_NAME=estoque_cozinha
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# Backend
JWT_SECRET=troque-este-segredo-em-producao-min-32-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origem do frontend aceita no CORS (em produção, o endereço público do front). Várias: separar por vírgula.
APP_URL_FRONTEND=http://localhost:3000

# E-mail (SMTP) — em dev o docker-compose.override.yml aponta pro Mailpit e ignora estes valores.
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@exemplo.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=