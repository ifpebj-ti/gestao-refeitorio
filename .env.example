# Banco de Dados
DB_NAME=estoque_cozinha
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# Backend
JWT_SECRET=troque-este-segredo-em-producao-min-32-chars
GOOGLE_CLIENT_ID=411051502805-kktsu5dn98f504upsj8jlh1qmroq9k48.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Origem do frontend aceita no CORS (em produção, o endereço público do front). Várias: separar por vírgula.
APP_URL_FRONTEND=http://localhost:3000,https://gestao-refeitorio-ifpe.duckdns.org

# E-mail (SMTP) — em dev o docker-compose.override.yml aponta pro Mailpit e ignora estes valores.
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@exemplo.com
# Envio diário dos alertas de estoque baixo e validade para as nutricionistas (false = só loga).
ALERTA_EMAIL_HABILITADO=false
# Link da tela de login enviado no e-mail de convite (em produção: https://gestao-refeitorio-ifpe.duckdns.org/login).
APP_URL_LOGIN=http://localhost:3000/login
# Primeiro ADMIN, criado ao subir só se não existir nenhum ADMIN ativo (em produção: misb@discente.ifpe.edu.br).
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_NOME=

# Observabilidade com OpenTelemetry → LGTM (#314). Desligado por padrão: só no .env do servidor,
# e só com a rede lgtm_default existente. Ver docs/OBSERVABILIDADE.md.
# JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar
# OTEL_SERVICE_NAME=gestao-refeitorio
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://lgtm-tempo-1:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://lgtm-mimir-1:9009/otlp/v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://lgtm-loki-1:3100/otlp/v1/logs

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=411051502805-kktsu5dn98f504upsj8jlh1qmroq9k48.apps.googleusercontent.com